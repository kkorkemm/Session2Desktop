<Page x:Class="Session2Desktop.Pages.AdminPages.AdminRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Session2Desktop.Pages.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Emergency Maintenance Request Details">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="10">
            <TextBlock Text="Selected Asset"
                       Style="{StaticResource TextTitle}"/>
            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Asset SN: "/>
                    <TextBlock Text="{Binding Assets.AssetSN}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Asset Name: "/>
                    <TextBlock Text="{Binding Assets.AssetName}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Department: "/>
                    <TextBlock Text="{Binding Assets.DepartmentLocations.Departments.Name}"
                               FontWeight="SemiBold"/>
                </StackPanel>

            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Asset EM Report"
                       Style="{StaticResource TextTitle}"/>

            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Grid.Row="1">

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Start Date: "/>
                    <DatePicker SelectedDate="{Binding EMStartDate}"
                                Width="200"
                                VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Completed Date: "/>
                    <DatePicker SelectedDate="{Binding EMEndDate}"
                                Width="200"
                                VerticalAlignment="Center"/>
                </StackPanel> 
                
            </WrapPanel>

            <TextBlock Text="Techinal Note: "
                       Margin="10"
                       Grid.Row="2"/>

            <TextBox x:Name="TextNote"
                     Text="{Binding EMTechnicianNote}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="auto"
                     Grid.Row="3"
                     Margin="10"/>

        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Replacement Parts"
                       Style="{StaticResource TextTitle}"
                       Margin="10"/>

            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Grid.Row="1">

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Part Name: "/>
                    <ComboBox x:Name="ComboPart"
                              Width="200"
                              VerticalAlignment="Center"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Amount: "/>
                    <TextBox x:Name="TextAmount"
                             Width="100"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnAdd"
                        Content="Add to list"
                        Click="BtnAdd_Click"
                        Style="{StaticResource BlueButton}"
                        Width="100"
                        VerticalAlignment="Center"
                        Margin="10"/>

            </WrapPanel>

            <DataGrid x:Name="ListParts"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      Grid.Row="2"
                      Margin="10">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Part Name"
                                        Width="2*"
                                        Binding="{Binding Parts.Name}"/>
                    <DataGridTextColumn Header="Amount"
                                        Width="*"
                                        Binding="{Binding Amount}"/>
                    <DataGridTemplateColumn Header="Action">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Style="{StaticResource RedButton}"
                                        x:Name="BtnRemove"
                                        Click="BtnRemove_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                
            </DataGrid>
            
        </Grid>

        <WrapPanel Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   Grid.Row="3">

            <Button x:Name="BtnSubmit"
                    Content="Submit"
                    Click="BtnSubmit_Click"
                    Style="{StaticResource BlueButton}"
                    Width="100"
                    Margin="10"/>

            <Button x:Name="BtnCancel"
                    Content="Cancel"
                    Click="BtnCancel_Click"
                    Style="{StaticResource RedButton}"
                    Width="100"
                    Margin="10"/>

        </WrapPanel>
 
    </Grid>
</Page>
