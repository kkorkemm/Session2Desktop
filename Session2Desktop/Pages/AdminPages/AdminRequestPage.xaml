<Page x:Class="Session2Desktop.Pages.AdminPages.AdminRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Session2Desktop.Pages.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Emergency Maintenance Request Details">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Data -->
        <GroupBox Header="Selected Asset"
                  Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                           Margin="10">
                    <TextBlock Text="Asset SN: "/>
                    <TextBlock Text="{Binding Assets.AssetSN}"/>
                </WrapPanel>

                <WrapPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Grid.Column="1"
                           Margin="10">
                    <TextBlock Text="Asset Name: "/>
                    <TextBlock Text="{Binding Assets.AssetName}"/>
                </WrapPanel>

                <WrapPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Grid.Column="2"
                           Margin="10">
                    <TextBlock Text="Department: "/>
                    <TextBlock Text="{Binding Assets.DepartmentLocations.Departments.Name}"/>
                </WrapPanel>

            </Grid>
        </GroupBox>

        <!-- Report Form -->
        <GroupBox Header="Asset EM Report"
                  Grid.Row="1"
                  Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Orientation="Horizontal"
                               Margin="10">
                        <TextBlock Text="Start Date: "
                                   Margin="0 0 5 0"/>
                        <DatePicker VerticalAlignment="Center"
                                    SelectedDate="{Binding EMStartDate}"
                                    Width="150"/>
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal"
                               Margin="10"
                               Grid.Column="1">
                        <TextBlock Text="Completed On: "
                                   Margin="0 0 5 0"/>
                        <DatePicker VerticalAlignment="Center"
                                    SelectedDate="{Binding EMEndDate}"
                                    Width="150"/>
                    </WrapPanel>

                </Grid>

                <TextBlock Text="Technician note: "
                           Margin="10"
                           Grid.Row="1"/>

                <TextBox Text="{Binding EMTechnicianNote}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Grid.Row="2"
                         Margin="5"/>

            </Grid>
        </GroupBox>

        <!-- Parts table -->
        <GroupBox Header="Replacement Parts"
                  Grid.Row="2"
                  Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           Margin="5">

                    <StackPanel Orientation="Horizontal"
                                Margin="5">
                        <TextBlock Text="Part name: "
                                   Margin="0 0 5 0"/>
                        <ComboBox x:Name="ComboParts"
                                  DisplayMemberPath="Name"
                                  Width="300"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="5">
                        <TextBlock Text="Amount: "
                                   Margin="0 0 5 0"/>
                        <TextBox x:Name="TextAmount"
                                 Width="100"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnAddList"
                            Content="+ Add to list"
                            Style="{StaticResource BlueButton}"
                            Margin="5"
                            Click="BtnAddList_Click"/>

                </WrapPanel>

                <DataGrid x:Name="ListParts"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          Grid.Row="1">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Part name"
                                            Width="2*"
                                            Binding="{Binding Parts.Name}"/>
                        <DataGridTextColumn Header="Amount"
                                            Width="*"
                                            Binding="{Binding Amount}"/>
                        <DataGridTemplateColumn Width="auto"
                                                Header="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button x:Name="BtnRemoveList"
                                            Content="Remove"
                                            Style="{StaticResource RedButton}"
                                            Click="BtnRemoveList_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>
        </GroupBox>


        <!-- Buttons -->
        <WrapPanel Grid.Row="3"
                   Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   Margin="10">

            <Button x:Name="BtnSubmit"
                    Content="Submit"
                    Style="{StaticResource BlueButton}"
                    Margin="5"
                    Click="BtnSubmit_Click"/>

            <Button x:Name="BtnCancel"
                    Content="Cancel"
                    Style="{StaticResource RedButton}"
                    Margin="5"
                    Click="BtnCancel_Click"/>

        </WrapPanel>

    </Grid>
</Page>
