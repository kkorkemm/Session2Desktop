<Page x:Class="Session2Desktop.Pages.AdminPages.AdminManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Session2Desktop.Pages.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Emergency Maintenance Management">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="List of Assets Requesting EM: "
                   Style="{StaticResource TextTitle}"/>

        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  Margin="10"
                  IsReadOnly="True"
                  x:Name="GridAssets">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Asset SN"
                                    Width="*"
                                    Binding="{Binding Assets.AssetSN}"/>
                <DataGridTextColumn Header="Asset Name"
                                    Width="*"
                                    Binding="{Binding Assets.AssetName}"/>
                <DataGridTextColumn Header="Request Date"
                                    Width="*"
                                    Binding="{Binding EMReportDate}"/>
                <DataGridTextColumn Header="Employee Full Name"
                                    Width="2*"
                                    Binding="{Binding Assets.Employees.FullName}"/>
                <DataGridTextColumn Header="Department"
                                    Width="*"
                                    Binding="{Binding Assets.DepartmentLocations.Departments.Name}"/>
            </DataGrid.Columns>

        </DataGrid>

        <Button x:Name="BtnManage"
                Click="BtnManage_Click"
                Content="Manage Request"
                Style="{StaticResource BlueButton}"
                Grid.Row="2"
                Margin="10"
                Width="200"
                HorizontalAlignment="Left"/>
    </Grid>
</Page>
