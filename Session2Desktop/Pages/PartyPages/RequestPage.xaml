<Page x:Class="Session2Desktop.Pages.PartyPages.RequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Session2Desktop.Pages.PartyPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Emergency Maintenance Management">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Data -->
        <GroupBox Header="Selected Asset"
                  Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                           Margin="10">
                    <TextBlock Text="Asset SN: "/>
                    <TextBlock Text="{Binding Assets.AssetSN}"/>
                </WrapPanel>

                <WrapPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Grid.Column="1"
                           Margin="10">
                    <TextBlock Text="Asset Name: "/>
                    <TextBlock Text="{Binding Assets.AssetName}"/>
                </WrapPanel>

                <WrapPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Grid.Column="2"
                           Margin="10">
                    <TextBlock Text="Department: "/>
                    <TextBlock Text="{Binding Assets.DepartmentLocations.Departments.Name}"/>
                </WrapPanel>

            </Grid>
        </GroupBox>


        <!-- Form -->
        <GroupBox Header="Request Report"
                  Grid.Row="1"
                  Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Margin="5"
                            Orientation="Horizontal">
                    <TextBlock Text="Priority: "/>
                    <ComboBox x:Name="ComboPriorities"
                              DisplayMemberPath="Name"
                              VerticalAlignment="Center"
                              Width="200"
                              SelectedItem="{Binding Priorities}"/>
                </StackPanel>

                <TextBlock Text="Description of Emergency"
                           Margin="5"
                           Grid.Row="1"/>
                <TextBlock Text="Other Considerations"
                           Margin="5"
                           Grid.Row="3"/>

                <TextBox Text="{Binding DescriptionEmergency}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Grid.Row="2"
                         Margin="5"/>

                <TextBox Text="{Binding OtherConsiderations}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Grid.Row="4"
                         Margin="5"/>

            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <WrapPanel Grid.Row="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   Margin="10">

            <Button x:Name="BtnSend"
                    Content="Send Request"
                    Style="{StaticResource BlueButton}"
                    Margin="5"
                    Click="BtnSend_Click"/>

            <Button x:Name="BtnCancel"
                    Content="Cancel"
                    Style="{StaticResource RedButton}"
                    Margin="5"
                    Click="BtnCancel_Click"/>

        </WrapPanel>

    </Grid>
</Page>
