<Page x:Class="Session2Desktop.Pages.PartyPages.RequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Session2Desktop.Pages.PartyPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Emergency Maintenance Management">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Selected Asset"
                       Style="{StaticResource TextTitle}"/>
            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Asset SN: "/>
                    <TextBlock Text="{Binding AssetSN}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Asset Name: "/>
                    <TextBlock Text="{Binding AssetName}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Department: "/>
                    <TextBlock Text="{Binding DepartmentLocations.Departments.Name}"
                               FontWeight="SemiBold"/>
                </StackPanel>

            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Request Report" 
                       Style="{StaticResource TextTitle}"/>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1"
                        Margin="10">

                <TextBlock Text="Priority: "/>
                <ComboBox x:Name="ComboPriority"
                          DisplayMemberPath="Name"
                          Width="200"
                          VerticalAlignment="Center"
                          Margin="10 0 0 0"/>

            </StackPanel>

            <TextBlock Text="Description of Emergency: "
                       Grid.Row="2"
                       Margin="10 0 0 0"/>

            <TextBox Grid.Row="3"
                     x:Name="TextDesc"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     Margin="10"/>

            <TextBlock Text="Other Considerations: "
                       Grid.Row="4"
                       Margin="10 0 0 0"/>

            <TextBox Grid.Row="5"
                     x:Name="TextOther"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     Margin="10"/>
            
        </Grid>

        <WrapPanel Grid.Row="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   Margin="10">

            <Button x:Name="BtnSend"
                    Content="Send Request"
                    Click="BtnSend_Click"
                    Style="{StaticResource BlueButton}"
                    Width="150"
                    Margin="10"/>

            <Button x:Name="BtnCancel"
                    Content="Cancel"
                    Click="BtnCancel_Click"
                    Style="{StaticResource RedButton}"
                    Width="150"
                    Margin="10"/>

        </WrapPanel>
        
    </Grid>
</Page>
